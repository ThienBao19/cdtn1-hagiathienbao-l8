{
  "name": "smartcrm-l8-backend",
  "version": "0.2.0",
  "description": "Smart CRM – Luồng L8: Khảo sát hài lòng CSAT / NPS",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/db-reset.js",
    "test": "jest --verbose"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "rootDir": "../..",
    "roots": [
      "<rootDir>/tests"
    ],
    "testEnvironment": "node",
    "watchman": false,
    "modulePaths": [
      "<rootDir>/src/backend/node_modules"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
