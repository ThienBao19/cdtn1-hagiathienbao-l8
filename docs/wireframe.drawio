;html=0;fontSize=8;align=center;verticalAlign=top;fontColor=#000000;fillColor=none;strokeColor=none;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1212" y="1010" width="40" height="16" as="geometry"/></mxCell><mxCell id="s169" value="T8" style="whiteSpace=wrap;html=0;fontSize=8;align=center;verticalAlign=top;fontColor=#000000;fillColor=none;strokeColor=none;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1254" y="1010" width="40" height="16" as="geometry"/></mxCell><mxCell id="s170" value="T9" style="whiteSpace=wrap;html=0;fontSize=8;align=center;verticalAlign=top;fontColor=#000000;fillColor=none;strokeColor=none;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1296" y="1010" width="40" height="16" as="geometry"/></mxCell><mxCell id="s171" value="── Tỉ lệ CSAT (%)     - - Chỉ số NPS" style="whiteSpace=wrap;html=0;fontSize=9;align=left;verticalAlign=top;fontColor=#333333;fillColor=none;strokeColor=none;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="970" y="818" width="360" height="16" as="geometry"/></mxCell><mxCell id="s172" value="Khi chưa có dữ liệu: “Chưa có phản hồi trong khoảng thời gian đã chọn”" style="whiteSpace=wrap;html=0;fontSize=9;align=left;verticalAlign=middle;fontColor=#000000;fillColor=#F2F2F2;strokeColor=#000000;dashed=1;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="476" y="970" width="420" height="26" as="geometry"/></mxCell><mxCell id="s173" value="Ghi chú: chỉ hiển thị dữ liệu của trung tâm Quản lý phụ trách (QT-14). Tỉ lệ CSAT, CSAT trung bình và chỉ số NPS được tính khi truy vấn theo BR-L8-03, không lưu thành cột. Bấm tên kỹ thuật viên → mở M2 đã lọc theo kỹ thuật viên đó." style="whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;fillColor=none;strokeColor=none;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="476" y="1042" width="860" height="50" as="geometry"/></mxCell><mxCell id="s174" value="CHÚ THÍCH: số đỏ [n] = trường dữ liệu, đối chiếu với cột ERD ở bảng 5.x · khung đỏ nét đứt = chỗ hiển thị thông báo của luồng ngoại lệ (mã bước/AC) · khung xám nét đứt = trạng thái rỗng. Wireframe tĩnh, không thể hiện màu sắc/phông chữ." style="whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;fillColor=#FFFDF0;strokeColor=#555555;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="1340" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>