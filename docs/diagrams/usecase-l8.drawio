<mxfile host="app.diagrams.net"><diagram id="Use Case L8" name="Use Case L8"><mxGraphModel dx="1180" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="Hệ thống: Khảo sát hài lòng CSAT/NPS (luồng L8)" style="whiteSpace=wrap;html=0;fontSize=14;align=center;verticalAlign=top;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;strokeWidth=2;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="580" height="620" as="geometry"/></mxCell><mxCell id="s2" value="UC1: Tạo lời mời khảo sát&#xa;khi phiếu bảo hành đã đóng" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455" y="77" width="270" height="66" as="geometry"/></mxCell><mxCell id="s3" value="UC2: Trả lời khảo sát hài lòng" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455" y="202" width="270" height="66" as="geometry"/></mxCell><mxCell id="s4" value="UC3: Tra cứu danh sách&#xa;phản hồi khảo sát" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455" y="337" width="270" height="66" as="geometry"/></mxCell><mxCell id="s5" value="UC4: Xem chỉ số CSAT/NPS&#xa;theo kỹ thuật viên" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455" y="457" width="270" height="66" as="geometry"/></mxCell><mxCell id="s6" value="UC5: Xem xu hướng CSAT/NPS&#xa;theo tháng" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455" y="557" width="270" height="66" as="geometry"/></mxCell><mxCell id="s7" value="Hệ thống quản lý&#xa;phiếu bảo hành&#xa;(hệ thống ngoài)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="114" y="62" width="32" height="68" as="geometry"/></mxCell><mxCell id="s8" value="" style="html=0;rounded=0;strokeWidth=1.5;strokeColor=#000000;fontSize=10;dashed=0;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="152" y="92" as="sourcePoint"/><mxPoint x="455" y="110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s9" value="Khách hàng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="114" y="205" width="32" height="68" as="geometry"/></mxCell><mxCell id="s10" value="" style="html=0;rounded=0;strokeWidth=1.5;strokeColor=#000000;fontSize=10;dashed=0;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="152" y="235" as="sourcePoint"/><mxPoint x="455" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s11" value="Nhân viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1014" y="340" width="32" height="68" as="geometry"/></mxCell><mxCell id="s12" value="" style="html=0;rounded=0;strokeWidth=1.5;strokeColor=#000000;fontSize=10;dashed=0;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1008" y="370" as="sourcePoint"/><mxPoint x="725" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s13" value="Quản lý&#xa;trung tâm" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1014" y="505" width="32" height="68" as="geometry"/></mxCell><mxCell id="s14" value="" style="html=0;rounded=0;strokeWidth=1.5;strokeColor=#000000;fontSize=10;dashed=0;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1008" y="535" as="sourcePoint"/><mxPoint x="725" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s15" value="" style="html=0;rounded=0;strokeWidth=1.5;strokeColor=#000000;fontSize=10;dashed=0;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1008" y="535" as="sourcePoint"/><mxPoint x="725" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s16" value="Chú thích:&#xa;• Hình người: actor – người hoặc hệ thống bên ngoài tương tác với hệ thống.  • Hình elip: use case.  • Khung chữ nhật: ranh giới hệ thống.&#xa;• Đường liền: actor thực hiện use case.  • Nhân viên = nhân viên chăm sóc khách hàng của trung tâm bảo hành (khác Nhân viên tiếp nhận ở L2).&#xa;• “Hệ thống quản lý phiếu bảo hành” (luồng L2/L4) báo sự kiện phiếu chuyển sang trạng thái Đã đóng; trong prototype được mô phỏng bằng lời gọi API1.&#xa;• Thuật ngữ dùng thống nhất với bảng thuật ngữ mục 1.1 của SRS." style="whiteSpace=wrap;html=0;fontSize=11;align=left;verticalAlign=top;fontColor=#000000;fillColor=#FFFDF0;strokeColor=#555555;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1140" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>