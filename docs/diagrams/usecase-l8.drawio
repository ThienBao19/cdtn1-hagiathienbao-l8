<mxfile host="app.diagrams.net"><diagram id="uc-l8" name="Use Case L8"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bnd" value="Hệ thống: Khảo sát hài lòng CSAT/NPS (luồng L8)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="580" height="670" as="geometry"/></mxCell><mxCell id="UC1" value="UC1: Tạo lời mời khảo sát&#xa;khi phiếu bảo hành đã đóng" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455.0" y="72.0" width="270" height="66" as="geometry"/></mxCell><mxCell id="UC2" value="UC2: Trả lời khảo sát hài lòng" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455.0" y="202.0" width="270" height="66" as="geometry"/></mxCell><mxCell id="UC3" value="UC3: Tra cứu danh sách&#xa;phản hồi khảo sát" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455.0" y="312.0" width="270" height="66" as="geometry"/></mxCell><mxCell id="UC4" value="UC4: Xử lý phản hồi&#xa;cần chăm sóc" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455.0" y="422.0" width="270" height="66" as="geometry"/></mxCell><mxCell id="UC5" value="UC5: Xem chỉ số CSAT/NPS&#xa;theo kỹ thuật viên" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455.0" y="527.0" width="270" height="66" as="geometry"/></mxCell><mxCell id="UC6" value="UC6: Xem xu hướng CSAT/NPS&#xa;theo tháng" style="ellipse;whiteSpace=wrap;html=0;fillColor=#F7F7F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455.0" y="617.0" width="270" height="66" as="geometry"/></mxCell><mxCell id="A1" value="Hệ thống quản lý&#xa;phiếu bảo hành&#xa;(hệ thống ngoài)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="114" y="52" width="32" height="70" as="geometry"/></mxCell><mxCell id="A2" value="Khách hàng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="114" y="212" width="32" height="70" as="geometry"/></mxCell><mxCell id="A3" value="Nhân viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1014" y="352" width="32" height="70" as="geometry"/></mxCell><mxCell id="A4" value="Quản lý&#xa;trung tâm" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1014" y="557" width="32" height="70" as="geometry"/></mxCell><mxCell id="c3" style="endArrow=none;html=1;" edge="1" parent="1" source="A1" target="UC1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4" style="endArrow=none;html=1;" edge="1" parent="1" source="A2" target="UC2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" style="endArrow=none;html=1;" edge="1" parent="1" source="A3" target="UC3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" style="endArrow=none;html=1;" edge="1" parent="1" source="A3" target="UC4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" style="endArrow=none;html=1;" edge="1" parent="1" source="A4" target="UC5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" style="endArrow=none;html=1;" edge="1" parent="1" source="A4" target="UC6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;dashed=1;html=1;endSize=10;" edge="1" parent="1" source="UC4" target="UC3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Chú thích:&#xa;• Hình người: actor (tác nhân) – người hoặc hệ thống bên ngoài tương tác với hệ thống.&#xa;• Hình elip: use case (chức năng mang lại giá trị cho actor).  • Khung chữ nhật: ranh giới hệ thống.&#xa;• Đường liền: actor thực hiện use case.  • Mũi tên nét đứt &lt;&lt;extend&gt;&gt;: UC4 chỉ xảy ra khi phản hồi ở UC3 có cờ “cần chăm sóc” (CSAT ≤ 2).&#xa;• “Hệ thống quản lý phiếu bảo hành” (luồng L2/L4) báo sự kiện phiếu chuyển sang trạng thái Đã đóng." style="shape=note;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFDF0;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="20" y="745" width="1140" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>