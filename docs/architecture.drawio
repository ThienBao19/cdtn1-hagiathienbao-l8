        <mxCell id="s16" parent="1" style="whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;fillColor=none;strokeColor=none;strokeWidth=1;spacingLeft=4;spacingRight=4;" value="Express (Node.js) – kiểm định dạng đầu vào (kiểu, độ dài), đọc vai trò + center_id từ JWT, chuyển lỗi nghiệp vụ thành mã HTTP 400/404/409/410" vertex="1">
          <mxGeometry height="44" width="804" x="238" y="325" as="geometry" />
        </mxCell>
        <mxCell id="s17" parent="1" style="whiteSpace=wrap;html=0;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;fillColor=#EAF6EA;strokeColor=#000000;strokeWidth=1.5;spacingLeft=4;spacingRight=4;" value="" vertex="1">
          <mxGeometry height="155" width="820" x="230" y="415" as="geometry" />
        </mxCell>
        <mxCell id="s18" parent="1" style="whiteSpace=wrap;html=0;fontSize=11;align=left;verticalAlign=top;fontColor=#000000;fillColor=none;strokeColor=none;fontStyle=1;strokeWidth=1;spacingLeft=4;spacingRight=4;" value="2. LỚP NGHIỆP VỤ (Service) – TOÀN BỘ quy tắc nghiệp vụ nằm ở lớp này; không biết dữ liệu lưu bằng công nghệ gì" vertex="1">
          <mxGeometry height="22" width="804" x="238" y="419" as="geometry" />
        </mxCell>
        <mxCell id="s19" parent="1" style="whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacingLeft=4;spacingRight=4;" value="InvitationService&#xa;• chỉ tạo lời mời cho phiếu Đã đóng, mỗi phiếu 1 lần (QT-10)&#xa;• sinh mã lời mời ngẫu nhiên 64 ký tự (NFR4)&#xa;• tính trạng thái, hạn 7 ngày (BR-L8-01)" vertex="1">
          <mxGeometry height="105" width="250" x="250" y="450" as="geometry" />
        </mxCell>
        <mxCell id="s20" parent="1" style="whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacingLeft=4;spacingRight=4;" value="SurveyService&#xa;• kiểm lời mời còn hạn / chưa trả lời&#xa;• kiểm CSAT 1–5, NPS 0–10, nhận xét ≤ 500 ký tự (BR-L8-02)&#xa;• không cho sửa phản hồi đã gửi (BR-L8-05)" vertex="1">
          <mxGeometry height="105" width="250" x="515" y="450" as="geometry" />
        </mxCell>
        <mxCell id="s21" parent="1" style="whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacingLeft=4;spacingRight=4;" value="ReportService&#xa;• tính tỉ lệ CSAT, chỉ số NPS (BR-L8-03)&#xa;• nhãn “Cần chăm sóc” CSAT ≤ 2 (BR-L8-04)&#xa;• giới hạn trung tâm theo vai trò (QT-14)&#xa;• che số điện thoại (QT-15, NFR4)" vertex="1">
          <mxGeometry height="105" width="250" x="780" y="450" as="geometry" />
        </mxCell>
        <mxCell id="s22" parent="1" style="whiteSpace=wrap;html=0;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;fillColor=#FFF4E5;strokeColor=#000000;strokeWidth=1.5;spacingLeft=4;spacingRight=4;" value="" vertex="1">
