d=0;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="206" as="sourcePoint"/><mxPoint x="1050" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s122l0" value="1" style="text;html=0;fontSize=10;fontStyle=1;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="1052" y="188" width="30" height="16" as="geometry"/></mxCell><mxCell id="s122l1" value="0..1" style="text;html=0;fontSize=10;fontStyle=1;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="1052" y="402" width="30" height="16" as="geometry"/></mxCell><mxCell id="s123" value="CHÚ THÍCH: PK = khóa chính (khóa nhân tạo) · FK = khóa ngoại · UQ = UNIQUE · NULL = cho phép rỗng (còn lại NOT NULL) · số đỏ ở đầu đường nối = lực lượng quan hệ (1, N, 0..1, 0..N).&#xa;INDEX: ticket(center_id, closed_at) · ticket(technician_id) · survey_response(responded_at) · survey_response(csat_score) – phục vụ NFR2 (lọc, sắp xếp, tổng hợp ≤ 3 giây).&#xa;KHÔNG LƯU giá trị tính được: trạng thái lời mời, hạn trả lời (= created_at + 7 ngày), nhãn “Cần chăm sóc”, tỉ lệ CSAT, chỉ số NPS → tính khi truy vấn.&#xa;Bảng ticket, customer, technician, service_center dùng chung với luồng L2/L4; L8 chỉ ĐỌC, nạp từ dữ liệu mẫu case study (tickets_history.csv, technicians.csv, service_centers.csv)." style="whiteSpace=wrap;html=0;fontSize=11;align=left;verticalAlign=top;fontColor=#000000;fillColor=#FFFDF0;strokeColor=#555555;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1200" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>