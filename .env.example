# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Database (PostgreSQL 16+). npm run migrate tự tạo CSDL DB_NAME nếu chưa có.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=postgres
DB_PASSWORD=your_password

# App
APP_PORT=3000
# Địa chỉ trang khảo sát (frontend React, Sprint 2) – dùng để tạo survey_url cho lời mời
FRONTEND_URL=http://localhost:5173
# Hạn trả lời lời mời khảo sát, tính bằng ngày (BR-L8-01)
INVITATION_VALID_DAYS=7
# Khoá ký JWT – dùng từ Sprint 2 (đăng nhập Nhân viên / Quản lý trung tâm)
SECRET_KEY=change_me
