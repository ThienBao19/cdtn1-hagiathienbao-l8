# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Database (PostgreSQL 16+). npm run migrate tự tạo CSDL DB_NAME nếu chưa có.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=postgres
DB_PASSWORD=your_password

# App
APP_PORT=3000
# Địa chỉ trang khảo sát (frontend React, Sprint 2) – dùng để tạo survey_url cho lời mời
FRONTEND_URL=http://localhost:5173
# Hạn trả lời lời mời khảo sát, tính bằng ngày (BR-L8-01)
INVITATION_VALID_DAYS=7
# Khoá ký JWT cho đăng nhập Nhân viên / Quản lý trung tâm – BẮT BUỘC, tối thiểu 16 ký tự, tự đặt chuỗi ngẫu nhiên
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-cua-ban
# Thời hạn phiên đăng nhập
JWT_EXPIRES_IN=8h

# Mức log: debug | info | warn | error (Buổi 11)
LOG_LEVEL=info
# Chỉ dùng khi chạy bằng Docker Compose: cổng mở ra máy
API_PORT=3000
WEB_PORT=8080
